#!/bin/sh

# Sourced by the release scripts before the VM boots.
#
# On Kubernetes each pod gets a long node name built from its IP (the chart
# injects POD_IP via the downward API), so DNSCluster can connect the pods it
# discovers through the headless Service named in DNS_CLUSTER_QUERY. The
# cookie comes from RELEASE_COOKIE in the pod's Secret.
#
# Without POD_IP (e.g. docker compose) the release defaults are kept.
if [ -n "$POD_IP" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="<%= @release.name %>@${POD_IP}"
fi
